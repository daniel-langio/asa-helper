ASA_BASE_URL=https://asa.hei.school
# Optional: path to the JSON payload file. Can also be passed as a CLI arg,
# which takes precedence over this. Defaults to payload.json in the cwd.
ASA_PAYLOAD_FILE=payload.json
# Optional: where the logged-in session gets cached between runs.
ASA_STATE_FILE=.asa_state.json
